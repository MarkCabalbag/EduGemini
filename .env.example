# Copy to .env and fill in. Every variable is described in docs/trd.md, Appendix A.
# Never commit .env. This file must always pass the API's startup validation.

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
LOG_LEVEL=info

# --- Database: the hosted Supabase project "edugemini" (TRD §4.3). Replace the placeholders. ---
# Prisma at runtime: transaction pooler, port 6543.
DATABASE_URL=postgresql://app_runtime.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations and db:boss:init: session pooler, owner role, port 5432.
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# pg-boss at runtime: session pooler, runtime role, port 5432.
PGBOSS_URL=postgresql://app_runtime.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Storage: local disk in development ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_BUCKET=edugemini
# Needed only when STORAGE_DRIVER=supabase:
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Secrets: generate your own. ENCRYPTION_KEY: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"` ---
ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
ENCRYPTION_KEY_VERSION=1
SESSION_SECRET=replace-with-at-least-32-random-characters

# --- Google sign-in (optional; leave unset to hide the button) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# GOOGLE_ISSUER=https://accounts.google.com

# --- Email: fake mailer in development (messages at GET /api/dev/outbox) ---
MAIL_DRIVER=fake
MAIL_FROM=EduGemini <no-reply@edugemini.local>
# Needed only when MAIL_DRIVER=smtp:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Gemini: fake adapter needs no key (TRD §11). Production is always live. ---
GEMINI_MODE=fake
GEMINI_MODEL=gemini-2.5-flash

REGRADE_DEBOUNCE_SECONDS=120
