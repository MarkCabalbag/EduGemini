{
  "name": "edugemini",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "pnpm --filter @edugemini/api db:generate",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "build": "pnpm -r --if-present build",
    "db:boss:init": "pnpm --filter @edugemini/api db:boss:init",
    "dev:api": "pnpm --filter @edugemini/api dev",
    "dev:web": "pnpm --filter @edugemini/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
