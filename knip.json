{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "apps/api": {
      "project": ["src/**/*.ts", "prisma/**/*.prisma"],
      "ignoreDependencies": ["pino-pretty"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/e2e": {
      "project": ["**/*.ts"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    }
  }
}
